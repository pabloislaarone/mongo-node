<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Social Media - <%= post ? "Editar Post" : "Nuevo Post" %></title>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/css/materialize.min.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
</head>
<body class="grey lighten-4">

  <nav>
    <div class="nav-wrapper teal">
      <a href="#!" class="brand-logo center">Social Media</a>
    </div>
  </nav>

  <div class="container" style="margin-top: 30px;">
    <h4 class="center-align"><%= post ? "Editar Post" : "Nuevo Post" %></h4>

    <form action="<%= post ? `/posts/${post._id}/update` : '/posts' %>" method="POST" class="col s12 m8 offset-m2">
      <% if (!post) { %>
        <div class="input-field">
          <input id="authorName" name="authorName" type="text" required placeholder="Nombre y apellido">
          <label for="authorName">Nombre del autor</label>
        </div>
      <% } %>

      <div class="input-field">
        <input id="title" name="title" type="text" minlength="5" maxlength="30" required value="<%= post ? post.title : '' %>">
        <label for="title" class="<%= post ? 'active' : '' %>">Título</label>
      </div>

      <div class="input-field">
        <textarea id="content" name="content" class="materialize-textarea" minlength="10" required><%= post ? post.content : '' %></textarea>
        <label for="content" class="<%= post ? 'active' : '' %>">Contenido</label>
      </div>

      <div class="input-field">
        <input id="hashtags" name="hashtags" type="text" value="<%= post && post.hashtags ? post.hashtags.join(', ') : '' %>">
        <label for="hashtags" class="<%= post && post.hashtags && post.hashtags.length ? 'active' : '' %>">Hashtags (separados por coma)</label>
      </div>

      <div class="input-field">
        <input id="imageUrl" name="imageUrl" type="text" value="<%= post && post.imageUrl ? post.imageUrl : '' %>">
        <label for="imageUrl" class="<%= post && post.imageUrl ? 'active' : '' %>">URL de imagen</label>
      </div>

      <button class="btn waves-effect waves-light teal" type="submit">
        <%= post ? "Actualizar" : "Publicar" %>
        <i class="material-icons right">send</i>
      </button>
      <a href="/posts" class="btn-flat">Cancelar</a>
    </form>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/materialize/1.0.0/js/materialize.min.js"></script>
</body>
</html>
